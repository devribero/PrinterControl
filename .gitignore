# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Dados gerados localmente (Coletar-Impressoras.ps1, Relatorio-Mensal.ps1 ou
# o simulador scripts/Simular-Ambiente.ps1) — nunca commitar: ou são dados
# reais da rede da empresa, ou são fictícios de teste; nenhum dos dois
# pertence ao repositório.
public/data/*.json

# Planilhas de levantamento/histórico (Fase 12, import_historico_planilha.py)
# — dado interno real da empresa (IP, departamento, contagem de páginas por
# impressora). Fica só na máquina de quem roda a importação, nunca no repo.
*.xlsx
*.xls

# Next.js build output
.next/

# Python
backend/venv/
backend/__pycache__/
**/__pycache__/
*.pyc
backend/*.db

# Env / secrets
.env
backend/.env
.claude/scheduled_tasks.lock

# Serena tool cache
.serena/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env.local
.env*.local

# Bancos SQLite nunca vao para o repositorio
*.db
*.db-journal

# Snapshots compactados do proprio codigo (backend.zip, frontend.zip): o
# repositorio ja e a fonte da verdade, versiona-los duplica o historico.
*.zip

# Cache incremental do compilador TypeScript — muda a cada build.
tsconfig.tsbuildinfo

# Operacao em producao (Fase 10)
backend/logs/
backend/backups/
# Companheiros do modo WAL do SQLite — estado transitorio, nunca versionado.
*.db-wal
*.db-shm
