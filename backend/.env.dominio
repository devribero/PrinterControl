# ===========================================================================
#  backend\.env  --  MAQUINA DO DOMINIO (bateria de testes)
#
#  Como usar: copie este arquivo para a maquina do dominio e renomeie para
#  ".env" dentro da pasta backend\. Ele substitui o .env de desenvolvimento.
#
#  Diferenca em relacao ao .env desta maquina (que fica em demo + mock):
#  aqui o Print Server e a coleta sao REAIS. E o ponto da bateria.
# ===========================================================================


# ---------------------------------------------------------------------------
#  Ambiente
# ---------------------------------------------------------------------------
# development, e nao production, de proposito. Producao exige CORS_ORIGINS
# so com https:// (config.py::_validate_production_cors) e o painel na
# maquina do dominio vai rodar em http://localhost:3000 -- o backend
# RECUSARIA SUBIR. E nao "demo" porque demo pinta a faixa permanente de
# "dados de demonstracao" no painel, o que faria dado REAL parecer ficticio.
ENVIRONMENT=development


# ---------------------------------------------------------------------------
#  Banco
# ---------------------------------------------------------------------------
# Caminho relativo e normalizado para absoluto sob backend\ pelo
# config.py::_absolute_sqlite_path, entao o cwd de quem sobe o servidor nao
# muda onde o banco fica.
#
# ATENCAO (teste GP-02 / D-19): o Pydantic da PRECEDENCIA a variavel de
# ambiente do Windows sobre este arquivo. Se a maquina do dominio tiver
# DATABASE_URL definida no ambiente (GPO, script de logon, outro projeto),
# esta linha e IGNORADA e o backend tenta abrir o banco errado. Confira antes
# de subir:
#     [Environment]::GetEnvironmentVariable('DATABASE_URL','User')
#     [Environment]::GetEnvironmentVariable('DATABASE_URL','Machine')
# Se aparecer alguma coisa, suba pelo Iniciar-Sistema.bat (ele limpa a
# variavel so na propria sessao) ou limpe na sessao antes:  set DATABASE_URL=
DATABASE_URL=sqlite:///./printer_control.db


# ---------------------------------------------------------------------------
#  Chave de assinatura dos JWT
# ---------------------------------------------------------------------------
# Gerada para ESTA instancia. Nao reaproveite em outro ambiente.
# Trocar esta chave invalida todos os tokens ja emitidos (todo mundo reloga).
SECRET_KEY=4nuSpdlDtaLGO2EAPfuRuLfFgUKooiD2_yUx4fNJW6fIqNQ1J6lFhSl8A53Xo1iv
ACCESS_TOKEN_EXPIRE_HOURS=24


# ---------------------------------------------------------------------------
#  Print Server  --  O QUE MUDA DE VERDADE NESTA CONFIGURACAO
# ---------------------------------------------------------------------------
# real = Get-Printer/Get-PrinterPort -ComputerName <host> via PowerShell,
# autenticado pelo token do processo (Kerberos/NTLM implicito). E o unico
# ponto do sistema que usa credencial de dominio -- ver D-01 e D-02.
PRINT_SERVER_MODE=real

# Confirme o nome ANTES de subir (teste RE-01):
#     Resolve-DnsName elgjunprt
#     Test-NetConnection elgjunprt -Port 135
# Se o nome curto nao resolver, use o FQDN (elgjunprt.<sufixo-do-dominio>).
# Evite IP puro: sem SPN, o IP forca NTLM, e dominio com NTLM restrito
# recusa -- ver D-03.
PRINT_SERVER_HOST=elgjunprt

# 30s e o default. Se o RPC estiver filtrado, o sintoma e "PowerShell nao
# respondeu em 30s" -- o timeout mascara porta fechada como lentidao.
PRINT_SERVER_TIMEOUT_SECONDS=30


# ---------------------------------------------------------------------------
#  Coleta simulada  --  DESLIGADA
# ---------------------------------------------------------------------------
# false de proposito: com true, a API pode gravar leituras ficticias no banco
# como se fossem reais, e dado inventado misturado com dado de frota real e
# indistinguivel depois. Na maquina do dominio nao existe motivo para isso.
ALLOW_MOCK_COLLECT=false


# ---------------------------------------------------------------------------
#  Coleta agendada  --  COMECA DESLIGADA. Ligue so no Bloco 5.
# ---------------------------------------------------------------------------
# false ate voce ter validado, na mao, os testes D-06 (ICMP) e D-07 (SNMP).
# Com true desde o inicio, o scheduler comeca a varrer a frota inteira antes
# de voce saber se o EDR corporativo aceita essa varredura (D-08) -- e o
# primeiro sinal seria um chamado da seguranca, nao um log.
#
# No Bloco 5, troque para true e reinicie o backend.
COLLECTION_ENABLED=false

# real = SNMP de verdade. Com mock aqui o backend nem sobe, porque
# ALLOW_MOCK_COLLECT=false (scheduler.py::start_scheduler recusa).
COLLECTION_MODE=real

# 5 min e o default. NAO use 1 (o valor do .env de desenvolvimento): contra
# uma frota real de ~79 impressoras, um ciclo por minuto pode nao terminar
# antes do proximo disparo -- e o APScheduler descarta o disparo seguinte em
# silencio (max_instances=1, coalesce=True). A coleta para sem erro nenhum.
COLLECTION_INTERVAL_MINUTES=5

# Consultas SNMP simultaneas. 4 e o default. Se a seguranca reclamar da
# varredura (D-08), baixar para 2 reduz a assinatura de scanner.
COLLECTION_MAX_WORKERS=4


# ---------------------------------------------------------------------------
#  SNMP
# ---------------------------------------------------------------------------
# "public" e o default do codigo. Se a norma da empresa desabilitou public em
# favor de uma community propria, troque AQUI -- senao o sintoma sera
# status_reason=ping_ok_snmp_not_responding em toda a frota, identico ao de
# SNMP desligado na impressora e ao de UDP/161 filtrado (D-07).
SNMP_COMMUNITY=public
SNMP_TIMEOUT=1.5
SNMP_RETRIES=1


# ---------------------------------------------------------------------------
#  CORS  --  origens de onde o painel pode chamar a API
# ---------------------------------------------------------------------------
# Cenario A (padrao, recomendado): navegador na PROPRIA maquina do dominio.
# As tres origens abaixo bastam e o backend continua escutando so em
# 127.0.0.1 -- nada da API fica exposto para a rede da empresa.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Cenario B: abrir o painel de OUTRA maquina (seu notebook, celular).
# Ai a linha acima nao basta -- acrescente o IP da maquina do dominio, e leia
# a secao "Cenario B" no fim deste arquivo, porque exige mais duas mudancas.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.36.1.34:3000


# ---------------------------------------------------------------------------
#  Proxy reverso  --  DESLIGADO
# ---------------------------------------------------------------------------
# false porque na maquina do dominio nao ha proxy na frente. Com true e sem
# TRUSTED_PROXY_IPS, qualquer cliente que alcance a porta inventa um
# X-Forwarded-For diferente a cada tentativa e escapa do limite de login
# (achado QA-10). O .env desta maquina esta com true -- nao leve isso junto.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900


# ---------------------------------------------------------------------------
#  Webhook do Teams  --  VAZIO ate o Bloco 6
# ---------------------------------------------------------------------------
# Vazio = desabilitado (webhook_notifier.py devolve False e so loga em debug).
# Deixe assim ate o Bloco 6: com a coleta real ligada, uma frota com varios
# toners baixos dispara um card por impressora e inunda o canal.
#
# Quando for testar (D-13 / IN-01), aponte para um canal de TESTE, nunca para
# o canal de producao. Nunca comite a URL preenchida -- ela carrega a
# assinatura (e o problema do achado A-01, que ja existe no Main.ps1).
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=5.0


# ---------------------------------------------------------------------------
#  Logs
# ---------------------------------------------------------------------------
# Rodando como tarefa agendada ninguem le o stdout: sem arquivo, um erro de
# madrugada nao deixa rastro. INFO registra o ciclo de coleta, que e
# justamente o que a bateria precisa auditar.
LOG_LEVEL=INFO
LOG_FILE=logs/printercontrol.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10


# ===========================================================================
#  CENARIO B  --  abrir o painel de outra maquina
# ===========================================================================
#
#  Por padrao o backend escuta SO em 127.0.0.1 (main.py e o script do
#  servico, os dois de proposito). Isso e o certo: a API nao tem TLS nem
#  nada na frente, e escutar em 0.0.0.0 a publica para a rede da empresa
#  inteira.
#
#  Se ainda assim precisar acessar de fora, sao TRES mudancas, nao uma:
#
#    1. CORS_ORIGINS -- descomente a linha do Cenario B com o IP real.
#
#    2. Suba o backend explicitamente em 0.0.0.0 (NUNCA pelo servico):
#         .\venv\Scripts\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000
#
#    3. next.config.ts, na raiz do projeto -- o IP precisa estar em
#       allowedDevOrigins, e o .env.local do frontend precisa apontar para
#       ele em vez de 127.0.0.1.
#
#  E lembre que o IP vem de DHCP corporativo: quando ele mudar, os tres
#  lugares quebram juntos (teste RE-06 / D-17).
#
#  Recomendacao: fique no Cenario A durante a bateria. Menos superficie, e
#  um problema a menos competindo com os que voce foi testar.
# ===========================================================================
