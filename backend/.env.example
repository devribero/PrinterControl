DATABASE_URL=sqlite:///./printer_control.db

# ---------------------------------------------------------------------------
# Ambiente e seguranca
# ---------------------------------------------------------------------------
# development (padrao) = maquina de quem desenvolve; simulacao liberada.
# demo                  = instancia de demonstracao. Dado ficticio e ESPERADO
#                         e o painel o anuncia permanentemente. NUNCA deve
#                         apontar para o banco de producao.
# production            = frota real. O backend RECUSA SUBIR se:
#                           - SECRET_KEY for a default ou tiver < 32 chars;
#                           - PRINT_SERVER_MODE != real;
#                           - ALLOW_MOCK_COLLECT=true.
#                         Ver app/config.py. Producao e demonstracao devem ser
#                         instancias separadas: processos e bancos diferentes.
ENVIRONMENT=development

# Chave de assinatura dos JWT. Gere uma propria antes de qualquer deploy:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Coleta simulada (/api/collect com mode="mock").
# Ligado apenas em desenvolvimento/demo: com ele ativo a API grava leituras
# ficticias no banco. Em ENVIRONMENT=production o backend nem sobe com esta
# variavel em true — nao e aviso, e recusa de boot.
ALLOW_MOCK_COLLECT=false

# ---------------------------------------------------------------------------
# Coleta agendada (APScheduler dentro do FastAPI)
# ---------------------------------------------------------------------------
COLLECTION_ENABLED=false
COLLECTION_INTERVAL_MINUTES=5
# mock = usa o simulador (exige ALLOW_MOCK_COLLECT=true) | real = SNMP de verdade
COLLECTION_MODE=real
COLLECTION_SCENARIO=online_mono
COLLECTION_MAX_WORKERS=4

# ---------------------------------------------------------------------------
# Print Server (Etapa 3) — fonte real das impressoras
# ---------------------------------------------------------------------------
# Fase 4: estes dois valores passaram a ser o PADRAO, nao mais a unica
# configuracao possivel. Os servidores ficam registrados na tabela
# `print_servers` (cada um com seu proprio modo) e sao gerenciados por
# GET/POST /api/servers. O host abaixo e registrado automaticamente na
# primeira inicializacao e e o usado pelas rotas sem id
# (/api/servers/discover e /api/servers/sync).
#
# mock = frota simulada, mesmo formato do real | real = Get-Printer/Get-PrinterPort via PowerShell
#
# ATENCAO: o default historico e "mock" e ele e OBRIGATORIAMENTE trocado para
# "real" em producao — o backend recusa subir do contrario. O motivo: um sync
# em modo simulado publica uma frota ficticia e marca como INATIVA toda
# impressora real que ela nao contem, ou seja, apaga a frota de producao.
PRINT_SERVER_MODE=mock
PRINT_SERVER_HOST=elgjunprt
PRINT_SERVER_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# SNMP (coleta real via UDP/161, usado pelo enriquecimento de discovery e
# pela coleta de frota) — ver backend/app/services/snmp.py
# ---------------------------------------------------------------------------
SNMP_COMMUNITY=public
SNMP_TIMEOUT=1.5
# Definido em config.py mas atualmente sem efeito: snmp.py nao implementa
# retry, cada consulta e feita uma unica vez. Mantido aqui apenas para nao
# esconder uma configuracao que existe no codigo.
SNMP_RETRIES=1

# ---------------------------------------------------------------------------
# Webhook de alerta critico de toner (Etapa 6) — Adaptive Card MS Teams/Power
# Automate. Vazio = desabilitado. NUNCA commitar a URL real aqui.
# ---------------------------------------------------------------------------
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# CORS (Fase 10) — origens do PAINEL autorizadas a chamar esta API
# ---------------------------------------------------------------------------
# Lista explicita, separada por virgulas. Com ENVIRONMENT=production o backend
# RECUSA SUBIR se estiver vazia, contiver "*", localhost/127.0.0.1, ou uma
# origem sem HTTPS.
#
# E a origem do FRONTEND que entra aqui — nao a do backend. Com o painel na
# Vercel e o backend exposto por Cloudflare Tunnel, o valor e o dominio da
# Vercel:
#   CORS_ORIGINS=https://SEU-APP.vercel.app
#
# Em desenvolvimento pode ficar ausente: o default cobre localhost:3000/3001.
# CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Logs (Fase 10)
# ---------------------------------------------------------------------------
# Rodando como tarefa agendada ninguem le stdout: sem arquivo, um erro de
# madrugada nao deixa rastro. Caminho relativo e resolvido sob backend/.
# Vazio = so console. Segredos sao redigidos antes de gravar (logging_config).
LOG_LEVEL=INFO
LOG_FILE=logs/printercontrol.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10

# ---------------------------------------------------------------------------
# Limite de tentativas de login (Fase 10)
# ---------------------------------------------------------------------------
# Sem isto, POST /api/auth/login aceitava tentativas ilimitadas: com o backend
# exposto por tunel, uma lista de senhas comuns podia ser testada na velocidade
# da rede. A contagem e por IP E por e-mail, em janela deslizante, e o acesso
# volta sozinho quando a janela passa (bloqueio permanente viraria negacao de
# servico contra o dono legitimo da conta).
#
# 5 tentativas / 15 min = 480 por dia - folgado para quem erra a senha,
# apertado para quem varre uma lista.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Confiar no cabecalho X-Forwarded-For para identificar o IP de origem.
#
# false (padrao): usa o IP da conexao. Correto quando o backend e acessado
#   direto - nesse caso o cabecalho e escolhido pelo CLIENTE, e confiar nele
#   permitiria trocar de "IP" a cada tentativa, anulando o limite.
# true: use APENAS quando houver um proxy de confianca na frente (Cloudflare
#   Tunnel, nginx) que reescreva o cabecalho. Sem isso, ligar aqui ENFRAQUECE
#   a protecao em vez de melhora-la.
#
# Nota: atras de um tunel, todo request chega com o mesmo IP de origem, entao
# a contagem por IP vira praticamente uma contagem global. E a contagem por
# E-MAIL que protege de verdade nesse cenario - ela nao depende desta opcao.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Senha das contas semeadas (usada apenas por seed.py, nunca pela API)
# ---------------------------------------------------------------------------
# Se definida, seed.py usa este valor (minimo 8 caracteres, o mesmo que a API
# exige). Se NAO definida, seed.py gera uma senha aleatoria forte e a mostra
# UMA UNICA VEZ no console.
#
# Nao precisa ficar no .env do servidor: o seed roda uma vez, na instalacao.
# Deixar a senha de administrador gravada em arquivo no servidor e pior do que
# digita-la no momento em que se roda o comando.
# SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Reload automatico do uvicorn (apenas desenvolvimento)
# ---------------------------------------------------------------------------
# Lido SO pelo bloco `python app/main.py`. Desligado por padrao: o reload
# reinicia o processo a cada arquivo salvo e derruba a coleta agendada junto.
# O servico de producao nao usa este bloco nem esta variavel.
#
# O host desse bloco e 127.0.0.1 fixo e NAO e configuravel: expor a API para
# a rede tem um caminho oficial (servico do Windows + Cloudflare Tunnel).
# DEV_RELOAD=true
